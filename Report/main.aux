\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Giant connected component (GCC) diagnostic for the cylindrical scan. \emph  {Top}: fraction of galaxies in the GCC as a function of the transverse linking length $r_\perp $. \emph  {Bottom}: its derivative $\mathrm  {d}\,\mathrm  {GCC}/\mathrm  {d}r_\perp $. The susceptibility peak ($r_{\mathrm  {critical}} = 1.34\,h^{-1}$ Mpc) and the maximum-gradient point ($1.36\,h^{-1}$ Mpc) locate the percolation threshold, while the fragmentation maximum ($r_{\mathrm  {groups}} = 0.54\,h^{-1}$ Mpc) marks the sub-critical group-finding scale adopted in this work.}}{2}{figure.caption.2}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:gcc}{{1}{2}{Giant connected component (GCC) diagnostic for the cylindrical scan. \emph {Top}: fraction of galaxies in the GCC as a function of the transverse linking length $r_\perp $. \emph {Bottom}: its derivative $\mathrm {d}\,\mathrm {GCC}/\mathrm {d}r_\perp $. The susceptibility peak ($r_{\mathrm {critical}} = 1.34\,h^{-1}$ Mpc) and the maximum-gradient point ($1.36\,h^{-1}$ Mpc) locate the percolation threshold, while the fragmentation maximum ($r_{\mathrm {groups}} = 0.54\,h^{-1}$ Mpc) marks the sub-critical group-finding scale adopted in this work}{figure.caption.2}{}}
\newlabel{fig:gcc@cref}{{[figure][1][]1}{[1][2][]2}{}{}{}}

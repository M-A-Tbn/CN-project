\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Galaxy distribution and groups in the (RA, Dec) plane, in four redshift bins $\Delta z = 0.01$. Top row: detected groups (this work). Bottom row: Tempel et al. (2014) reference. Grouped galaxies are coloured by group ID and scaled by $\log _{10}$ richness. Field galaxies appear in grey. The spatial distributions and group sizes are consistent across all four bins and between the two catalogs, with no systematic trend with redshift.}}{3}{figure.caption.4}\protected@file@percent }
\newlabel{fig:radec_catalogue}{{3}{3}{Galaxy distribution and groups in the (RA, Dec) plane, in four redshift bins $\Delta z = 0.01$. Top row: detected groups (this work). Bottom row: Tempel et al. (2014) reference. Grouped galaxies are coloured by group ID and scaled by $\log _{10}$ richness. Field galaxies appear in grey. The spatial distributions and group sizes are consistent across all four bins and between the two catalogs, with no systematic trend with redshift}{figure.caption.4}{}}
\newlabel{fig:radec_catalogue@cref}{{[figure][3][]3}{[1][3][]3}{}{}{}}

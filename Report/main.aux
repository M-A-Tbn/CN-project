\def\@LN@column{2}
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Percolation scan over $r_\perp $. Teal curve: susceptibility $\chi $ (left axis). Blue curve: fragmentation count $N_{\rm  groups}$ (right axis). Dashed black line: $r_{\rm  critical}^\perp = 1.34\,h^{-1}$ Mpc. Dotted red line: $r_{\rm  groups}^\perp = 0.54\,h^{-1}$ Mpc. The sub-critical inequality $r_{\rm  groups} < r_{\rm  critical}$ confirms that the chosen scale targets groups rather than filaments or clusters.}}{2}{figure.caption.2}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:phase_transition}{{1}{2}{Percolation scan over $r_\perp $. Teal curve: susceptibility $\chi $ (left axis). Blue curve: fragmentation count $N_{\rm groups}$ (right axis). Dashed black line: $r_{\rm critical}^\perp = 1.34\,h^{-1}$ Mpc. Dotted red line: $r_{\rm groups}^\perp = 0.54\,h^{-1}$ Mpc. The sub-critical inequality $r_{\rm groups} < r_{\rm critical}$ confirms that the chosen scale targets groups rather than filaments or clusters}{figure.caption.2}{}}
\newlabel{fig:phase_transition@cref}{{[figure][1][]1}{[1][2][]2}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces GCC diagnostic. Top: GCC coverage as a function of $r_\perp $, with vertical markers. Bottom: derivative $d({\rm  GCC})/dr_\perp $. The maximum gradient (orange) lies near the susceptibility peak (blue), both of which correspond to the cluster/supercluster scale.}}{2}{figure.caption.3}\protected@file@percent }
\newlabel{fig:gcc_diagnostic}{{2}{2}{GCC diagnostic. Top: GCC coverage as a function of $r_\perp $, with vertical markers. Bottom: derivative $d({\rm GCC})/dr_\perp $. The maximum gradient (orange) lies near the susceptibility peak (blue), both of which correspond to the cluster/supercluster scale}{figure.caption.3}{}}
\newlabel{fig:gcc_diagnostic@cref}{{[figure][2][]2}{[1][2][]2}{}{}{}}
